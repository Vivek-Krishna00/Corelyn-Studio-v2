{
  "name": "corelyn-studio",
  "productName": "Corelyn Studio",
  "private": true,
  "version": "0.1.0",
  "description": "Corelyn Studio — mission authoring and monitoring for Corelyn Robotics ROS2 platforms.",
  "homepage": "https://corelynrobotics.com",
  "type": "module",
  "main": "electron/main.cjs",
  "author": {
    "name": "Corelyn Robotics",
    "email": "team@corelynrobotics.com"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:dev": "concurrently -k -n VITE,ELECTRON -c blue,magenta \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "electron:build": "vite build && electron-builder",
    "electron:build:mac": "vite build && electron-builder --mac",
    "electron:build:win": "vite build && electron-builder --win",
    "electron:build:linux": "vite build && electron-builder --linux",
    "test:e2e": "make -C backend dev && vite build && playwright test"
  },
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "vite": "^8.0.12",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.corelynrobotics.studio",
    "productName": "Corelyn Studio",
    "files": [
      "dist/**/*",
      "electron/*.cjs"
    ],
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "backend/dist/corelyn-studiod",
        "to": "bin/corelyn-studiod"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "maintainer": "Corelyn Robotics <team@corelynrobotics.com>"
    }
  }
}
